{
  "info": {
    "name": "Daily Tasks API",
    "description": "Postman collection for the Daily Tasks Laravel API (offline-first).\n\nHow to use:\n1. Import this file and the environment file.\n2. Make sure baseUrl points to your server, e.g. http://127.0.0.1:8000/api/v1\n3. For every request use Body -> raw -> JSON (NOT Text). This is the most common cause of 422 errors.\n4. Run Auth > Register (or Login) first. The access/refresh tokens are saved automatically.\n5. Then run any other folder; created ids are saved automatically.\n\nRegister password policy: at least 8 characters with one uppercase letter and one digit (example: StrongPass123).\nMessages are returned in Arabic by default (APP_LOCALE=ar); send the header Accept-Language: en for English.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.collectionVariables.set('currentDate', now.toISOString().slice(0, 10));",
          "pm.collectionVariables.set('currentMonth', now.toISOString().slice(0, 7));",
          "pm.collectionVariables.set('futureDate', new Date(now.getTime() + 30 * 24 * 3600 * 1000).toISOString().slice(0, 10));",
          "pm.collectionVariables.set('reminderTime', new Date(now.getTime() + 3600 * 1000).toISOString());",
          "pm.collectionVariables.set('nowIso', now.toISOString());"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "studyPlanId", "value": "" },
    { "key": "sportSessionId", "value": "" },
    { "key": "reminderId", "value": "" },
    { "key": "conflictId", "value": "" },
    { "key": "deviceId", "value": "dev_a1b2c3" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "if (data.accessToken) { pm.collectionVariables.set('accessToken', data.accessToken); }",
                  "if (data.refreshToken) { pm.collectionVariables.set('refreshToken', data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"أحمد\",\n  \"email\": \"ahmad@example.com\",\n  \"password\": \"StrongPass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "if (data.accessToken) { pm.collectionVariables.set('accessToken', data.accessToken); }",
                  "if (data.refreshToken) { pm.collectionVariables.set('refreshToken', data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmad@example.com\",\n  \"password\": \"StrongPass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "if (data.accessToken) { pm.collectionVariables.set('accessToken', data.accessToken); }",
                  "if (data.refreshToken) { pm.collectionVariables.set('refreshToken', data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "response": []
        },
        {
          "name": "Me",
